{
  "manifestVersion": 1,
  "pluginId": "ai.rever.boss.plugin.dynamic.jev",
  "displayName": "Jev",
  "version": "0.2.0",
  "apiVersion": "1.0.96",
  "minApiVersion": "1.0.96",
  "dependencies": [
    {
      "pluginId": "ai.rever.boss.plugin.dynamic.aigateway",
      "version": ">=1.1.14",
      "optional": true
    }
  ],
  "minBossVersion": "9.4.2",
  "mainClass": "ai.rever.boss.plugin.dynamic.jev.JevDynamicPlugin",
  "type": "panel",
  "description": "Ask a decision model structured questions from a sidebar panel or the BOSS MCP server. Calls go through the AI Gateway, to Jev on OpenRouter or a local model on this machine.",
  "author": "Risa Labs",
  "url": "https://github.com/risa-labs-inc/boss-plugin-jev",
  "requiresAdmin": false,
  "panel": {
    "position": "right_top_bottom",
    "priority": 60
  },
  "sandbox": {
    "maxThreads": 6,
    "maxRestartAttempts": 3,
    "heartbeatIntervalMs": 5000
  }
}
